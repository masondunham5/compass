# Health Hub stores data locally in data/ by default.
# Do not place personal secrets or production tokens in a committed .env file.

# Garmin Connect Personal API (optional; this file is a template only)
# On the old laptop, copy this file to .env and paste your personal key after =.
# Never share this key or commit the real .env file.
GARMIN_PERSONAL_API_KEY=

# Optional but recommended: lets Health Hub warn you before Garmin expires it.
# Example: 2027-11-14
GARMIN_KEY_EXPIRES_ON=

# Daily scheduled sync uses a small rolling window, so late Garmin uploads are caught.
GARMIN_SYNC_DAYS=2
